{
  "name": "@pasquelin/panels",
  "version": "0.1.0",
  "description": "Châssis à panneaux React : rails d'icônes, zones redimensionnables, centre libre. Headless + composants par défaut, entièrement surchargeable.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Alban Pasquelin <alban.pasquelin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasquelin/panels.git"
  },
  "homepage": "https://github.com/pasquelin/panels#readme",
  "bugs": "https://github.com/pasquelin/panels/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src examples",
    "format": "prettier --write \"{src,examples}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,examples}/**/*.{ts,tsx,css}\"",
    "dev": "vite --config examples/minimal/vite.config.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  }
}
